# Operator template only. No resources are created and no production values belong here.
# Use distinct services/roles/secrets/provider test applications before enabling FEATURES.
PUBLIC_ORIGIN=https://staging.sim.frostdev.io
FROSTSIM_ACCOUNT_HOST=127.0.0.1
FROSTSIM_ACCOUNT_PORT=3912
FEATURES=
DATABASE_URL=postgres://frostsim_staging:REPLACE_WITH_STAGING_PASSWORD@127.0.0.1:5434/frostsim_staging
REDIS_URL=redis://frostsim_staging:REPLACE_WITH_STAGING_PASSWORD@127.0.0.1:6380/0
# Deliberately too short to pass startup validation; replace with a random secret >=32 bytes.
SESSION_SECRET=REPLACE_ME
ENGINE_INDEX_PATH=/opt/frostsim-staging/engine-updates/engine-channels.json
ENGINE_COMPAT=REPLACE_WITH_REVIEWED_APP_COMPAT
WOW_API_ORIGIN=http://127.0.0.1:3911
# Stripe test keys, OAuth test applications and object-storage prefixes must be separate.
# Keep this template's FEATURES empty until the separate account service is present and tested.
